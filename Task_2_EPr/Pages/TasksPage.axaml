<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Task_2_EPr.TasksPage">
    <Grid>
        <Border Grid.Row="1" Background="{DynamicResource PageBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1">
            <StackPanel Margin="10">
                <StackPanel Margin="10 0 0 15">
                    <TextBlock FontSize="15" FontWeight="DemiBold">Задачи</TextBlock>
                </StackPanel>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="10">
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Разработать макет главной страницы" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="{DynamicResource DesignTagBackgroundBrush}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="Дизайн" Foreground="{DynamicResource DesignTagTextBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="15.05.2024" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="10">
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Реализовать авторизацию" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="{DynamicResource DevelopmentTagBackgroundBrush}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="Разработка" Foreground="{DynamicResource DevelopmentTagTextBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="14.05.2024" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="10">
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Подготовить презентацию" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="{DynamicResource MarketingTagBackgroundBrush}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="Маркетинг" Foreground="{DynamicResource MarketingTagTextBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="13.05.2024" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
