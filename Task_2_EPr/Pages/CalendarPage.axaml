<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Task_2_EPr.CalendarPage">
    <Grid>
        <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1">
            <StackPanel Margin="10">
                <StackPanel Margin="10 0 0 15">
                    <TextBlock FontSize="15" FontWeight="DemiBold">Календарь</TextBlock>
                </StackPanel>
                <Calendar HorizontalAlignment="Center" CornerRadius="10"></Calendar>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
