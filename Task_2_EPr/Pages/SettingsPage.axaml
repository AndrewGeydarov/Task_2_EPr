<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Task_2_EPr.SettingsPage">
    <Grid>
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource PageBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1">
            <StackPanel Margin="10">
                <StackPanel Margin="10 0 0 15" Grid.Row="0">
                    <TextBlock FontSize="15" FontWeight="DemiBold">Настройки</TextBlock>
                </StackPanel>
                <Border Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" CornerRadius="10">
                    <ToggleSwitch Name="ThemeSwitch" IsCheckedChanged="Theme_IsCheckedChanged" Content="Темная тема" Margin="30"></ToggleSwitch>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
