<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Task_2_EPr.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Task_2_EPr.ProjectsPage"
             x:DataType="viewmodels:MainViewModel">
    <Grid>
        <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1">
            <StackPanel Margin="10">
                <StackPanel Margin="10 0 0 15">
                    <TextBlock FontSize="15" FontWeight="DemiBold">Проекты</TextBlock>
                </StackPanel>
                <DataGrid Name="ProjectsDG" ItemsSource="{Binding Projects}" Margin="10 0" CornerRadius="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер проекта" Binding="{Binding ProjectNum}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Название проекта" Binding="{Binding ProjectName}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Сроки проекта" Binding="{Binding Date}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
