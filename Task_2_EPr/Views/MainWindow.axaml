<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="330"
        x:Class="Task_2_EPr.Views.MainWindow"
        Title="Авторизация">
    <Grid>
        <Border Background="{DynamicResource PageBackgroundBrush}" Margin="10" CornerRadius="10">
            <StackPanel Margin="20" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Авторизация" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0 0 0 8"/>
                <TextBox Name="LoginTB" CornerRadius="8" Watermark="Логин"/>
                <TextBox Name="PasswordTB" CornerRadius="8" PasswordChar="●" Watermark="Пароль"/>
                <TextBlock Name="ErrorTB" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <Button HorizontalAlignment="Stretch" CornerRadius="8" Background="BlueViolet" Foreground="White" Click="Enter_Click">Войти</Button>
                <TextBlock Text="Тестовый вход: admin / admin123" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
