<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        Width="400" Height="250"
        x:Class="Task_2_EPr.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Task_2_EPr">

    <Grid>
        <Border Background="{DynamicResource PageBackgroundBrush}" Margin="10" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Авторизация" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 30 0 15" FontWeight="Bold"/>
                <TextBox Name="LastNameTB" CornerRadius="10" Watermark="Фамилия" Margin="0 0 0 15"></TextBox>
                <TextBox Name="NameTB" CornerRadius="10" Watermark="Имя" Margin="0 0 0 15"></TextBox>
                <Button Name="Enter" HorizontalAlignment="Center" CornerRadius="10" Background="BlueViolet" Foreground="White" Click="Enter_Click">Войти</Button>
            </StackPanel>
        </Border>
    </Grid>

</Window>
